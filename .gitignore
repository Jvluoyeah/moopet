# Local secrets (the application reads process environment variables)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Python dependencies and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local databases, journals and database backups; keep JSON question banks
*.db
*.db-*
*.db.bak*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sqlite.bak*
*.sqlite3.bak*

# Node dependencies and frontend build output
node_modules/
/web/dist/
/web/render/

# Generated screenshots and logs
/web/tests/shots/
*.log
logs/

# ROS2 / colcon output
/moopet_ws/build/
/moopet_ws/install/
/moopet_ws/log/

# Blender automatic backups (keep the .blend source)
*.blend[0-9]

# Local OS/editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
