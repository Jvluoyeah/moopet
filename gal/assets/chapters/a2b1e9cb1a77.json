{"id":"8b370f48-c304-466c-b6c0-a6413359de18","name":"开始","fragments":[{"id":"frag-开始-main","name":"main","blocks":[{"id":"da6fc87a-f605-4154-8ab3-9f989040769b","type":"showExtensionUI","props":{"disabled":false,"target":"slot:internal.system.title","modal":true,"layer":"topmost","seekBehavior":"skip-if-seeking","size":"","position":"","interactable":""},"x-note":"title-screen"},{"id":"91eead21-08d8-4256-8ebd-271b04e28abb","type":"curtain","props":{"disabled":false,"op":"open","effect":"","duration":"800","color":"#000000","mode":"full-screen","curtainSize":"100"},"x-note":"title-flow"},{"id":"e361984f-41f0-46a0-89dc-ec438589a9f8","type":"sound","props":{"disabled":false,"soundType":"BGM","soundId":"","uri":"audio/2d7bfa329f874193bb6dd29c65c9dd6a.wav","volume":"38","loop":"true","fadeDuration":"1800"},"x-src":"wire-assets"},{"type":"scene","props":{"disabled":false,"sceneId":"fad020bf-6eb3-4de3-9884-f5003a3f3a2a","sceneName":"登记处","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"id":"86ad8e61-b587-47e5-8ccd-d28b294b1064","x-src":"场景 00-1"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"——那是一扇连门牌都快被冻结的腐锈斑痕吞噬的破旧木门。","styles":{}}],"id":"77d52822-d42c-4b05-86b5-8af5108edaca","x-src":"narr"},{"id":"1250f23a-688c-45b1-8bd3-43fe6dbc5c22","type":"scene","props":{"disabled":false,"sceneId":"51254a0e-3945-4a50-bb0f-1be8e489eb9d","sceneName":"登记处外","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"x-note":"wire-scene"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我推开门。头顶悬挂的黄铜铃铛发出了一声极其短促的哀鸣。","styles":{}}],"id":"f0b76699-4ff4-4077-84e1-37c250b9df17","x-src":"narr"},{"id":"3d5bb1b0-91a6-4253-81a1-2603610390e5","type":"sound","props":{"disabled":false,"soundId":"se-door","uri":"audio/11bcdc68c94f9fb06d5f7daf1a33f9db.mp3","soundType":"se","volume":"80","loop":"false","fadeDuration":"0"},"x-note":"sfx"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"——叮。","styles":{}}],"id":"12a99bad-84d6-4481-82fd-8fdb27e7de1b","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"单薄、干瘪，仿佛连发声的力气都被屋内粘稠的死寂吞噬殆尽。","styles":{}}],"id":"5e1fd44a-e899-4f3c-8e12-657e630a2b63","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"狭小的屋子里仅仅摆放着一张粗糙的原木柜台。柜台上方悬着一盏裸露的白炽灯，昏黄而刺目的光晕如同手术台的探照灯般倾泻而下。灯光正下方，坐着一个约莫四十岁上下的女人，身上套着一件洗得几乎褪成灰白色的旧褂子。","styles":{}}],"id":"0ed34af8-fe8c-48e6-8166-9944cf3ae92d","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她没有抬起眼皮。","styles":{}}],"id":"55e8c365-62cd-4456-8387-e968c190a81c","x-src":"bare"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"登记？","styles":{}}],"id":"2672f953-2497-4bc2-80d1-86ba0648ba61","x-src":"narr"},{"type":"dialogue","props":{"characterId":"7642a946-bc01-4ffd-8c17-47f9b0678ee2","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"……嗯。","styles":{}}],"id":"ce31fa79-c1aa-4eb7-8d88-c7d4b4e04f3d","x-src":"attr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"直到听见我干涩的声音，她才终于停下手中的笔尖，用一种毫无波澜、冷冽如刀的目光审视了我一眼。那眼神像是在精确丈量我体内的耐性与残存的体温。","styles":{}}],"id":"1b27688a-8170-4229-83fa-c1d96eb2ad8f","x-src":"attr"},{"type":"scene","props":{"disabled":false,"sceneId":"fad020bf-6eb3-4de3-9884-f5003a3f3a2a","sceneName":"登记处","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"id":"0bbbdd4b-cfd7-4edb-86f7-b5fd59ee44fa","x-src":"场景 00-2"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"证件。","styles":{}}],"id":"d8679eec-2da7-4ab6-83c8-bbf9593eadb4","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我没有废话，从大衣内侧将那张被掌心冷汗浸得发软的排队纸递了过去。","styles":{}}],"id":"a1855bca-1490-4e83-8529-30c0b785c5d9","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她伸出枯瘦的指节接过，借着刺目的灯泡一寸一寸地扫视着，那近乎苛刻的神情，比刚才打量我这具活生生的躯体时要认真十倍。随后，伴随轴承缺油的呻吟，她拉开沉重的抽屉，取出一本硬壳记事本。","styles":{}}],"id":"81c8ca71-1bbe-4b35-8b2b-cb85b23fff2f","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"翻页，落笔。她将我的那张纸如同标本般冷酷地夹了进去。","styles":{}}],"id":"25a3936b-6dc6-4994-8848-2f1caeed8fc9","x-src":"attr"},{"type":"dialogue","props":{"characterId":"","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"等这个通知……等了一个多月。","styles":{}}],"id":"6e557bfd-6e72-41f7-8d6c-e700793f44b3","x-src":"narr"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"排队的多。狗少。","styles":{}}],"id":"e5feea7a-a534-4407-89cf-f31a6922974c","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她头也不抬地吐出这六个冰冷的字，直接堵死了任何闲聊的可能。","styles":{}}],"id":"fd2feb25-0791-42f1-82df-dff63d0984ec","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"紧接着，她从柜台下方搬出一件东西，重重地推到了我的面前。","styles":{}}],"id":"0048536c-8d18-4833-8ba7-5fd969cab9f1","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"——咚。","styles":{}}],"id":"aa527788-d7b5-455c-8b47-c9873a5938ef","x-src":"attr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"那是一本厚实的牛皮纸档案册，足有拇指半那么厚，封面上干干净净，没有印刷任何字样，唯有粗粝的纤维纹理散发着冰冷的触感。","styles":{}}],"id":"c068d4c3-4eac-40b5-8881-fb8d52df2b29","x-src":"narr"},{"id":"d5822ff3-6f4f-465c-889f-043fd98516b0","type":"scene","props":{"disabled":false,"sceneId":"1423ca15-1a88-44e6-855d-c820a1327024","sceneName":"册子的一页","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"x-note":"wire-scene"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我伸出冻僵的指尖翻开扉页。里面是一页接着一页死寂的空白。","styles":{}}],"id":"f22c1e72-1944-4864-8684-3e092db3fffa","x-src":"bare"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"这是档案册。纸的。","styles":{}}],"id":"db8f149f-476e-49fa-864c-cd7e74422535","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我一页一页往下翻。每一页的页脚边缘，都用极细的红色钢笔工整地标注着手写的目录：","styles":{}}],"id":"d15dc3a7-98a1-49f2-8768-cac52da58485","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"【总览】。【开放世界】。【竞技场】。【训练记录】。【狗狗档案】。【排行榜】。","styles":{}}],"id":"655aee0b-6c26-4ce0-889d-0dbb47aaca74","x-src":"attr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"不仅如此，每一页的侧边缝隙处，都严丝合缝地压印着一道鲜红的骑缝印章。印泥深深浸透纸背，横跨左右两页；而在每一页的右上角，都划着一条短短的横线，前方印着未填的编号。","styles":{}}],"id":"c35dfae3-af15-44c0-8e36-bed8f6e0e477","x-src":"narr"},{"type":"scene","props":{"disabled":false,"sceneId":"fad020bf-6eb3-4de3-9884-f5003a3f3a2a","sceneName":"登记处","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"id":"b1e4622d-4bdd-442d-8c1a-d7c8ea007492","x-src":"场景 00-3"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我停下动作，合上了那本沉重得令人心慌的册子。她一直没有催促我。","styles":{}}],"id":"ca508fec-9047-4d5b-8de9-2fcd8e313d77","x-src":"bare"},{"id":"16bfe551-8fa5-432b-86c8-a48e00235207","type":"dialogue","props":{"characterId":"","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"……为什么不存进手机里？","styles":{}}],"x-note":"name-input"},{"id":"a96bc784-abaa-4bc0-864e-f354b7a23f25","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"听闻此言，她的眼皮微微抬了抬。","styles":{}}],"x-note":"name-input"},{"id":"d91b503e-dbde-4b66-8b7b-75ef96f75228","type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"你手机里，现在还留着三年前拍的照片吗？","styles":{}}],"x-note":"name-input"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"——心脏像是被冷不丁刺中了一下。我试图在脑海中搜寻，最终只能徒劳地收紧喉咙。","styles":{}}],"id":"78770e68-b278-41d5-8157-5a7f537019c7","x-src":"narr"},{"type":"dialogue","props":{"characterId":"dc4ccb21-1ce4-4ad3-8fa3-5e8a2658bb51","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"……留着。有一部分。","styles":{}}],"id":"90e1aa9d-0936-4597-8843-db6e0a02e77c","x-src":"attr"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"那挺好。说明你算个念旧的稀罕货。在这长夜里，大部分人打开三年前的相册，跳出来的只有一个灰色的叉。数据会丢，但纸不会。","styles":{}}],"id":"fbf124e2-8682-4b91-8e6f-b6cd29ba719c","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她将册子往我的方向又无情地推了半寸。","styles":{}}],"id":"8752906e-5be2-4e1e-8f87-bb6575a20af1","x-src":"attr"},{"type":"scene","props":{"disabled":false,"sceneId":"fad020bf-6eb3-4de3-9884-f5003a3f3a2a","sceneName":"登记处","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"id":"165c1445-dc60-4f38-8646-39b4642db7b6","x-src":"场景 00-4"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"别发愣了。先报上名来。","styles":{}}],"id":"fc4ff75a-94ff-4023-8fb9-c8c90bbd59d7","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她说这一句的时候，将册子翻回了第一页。在那个赫然印着编号的横线下方，有一块长方形的空白栏。","styles":{}}],"id":"7c666276-1a9a-4422-891e-1326d88b42d8","x-src":"bare"},{"id":"edd159c0-6c26-4efb-8bff-3ec327033676","type":"playerInput","props":{"disabled":false,"variable":"dog_name","valueType":"string","title":"你的名字","description":"在第一页那一栏的横线上，写下你的名字。","placeholder":"写下你的名字……","confirmText":"落笔","requiredText":"请填写后再继续","required":true,"minLength":0,"maxLength":20,"step":1,"trueText":"是","falseText":"否"},"x-note":"name-input"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我握紧冰冷的钢笔，将自己的名字一笔一划、用力地刻在了那张微黄的纸纤维深处。","styles":{}}],"id":"a425b134-4bd5-4e90-8ab4-bc5b836cd933","x-src":"narr"},{"id":"406ea745-a5b0-4eba-8602-64f0cf715b77","type":"removeCharacter","props":{"disabled":false,"characterId":"7491fed9-0faf-478b-8cb0-6fa47e07e9eb","characterName":"我"},"x-note":"timing-exit"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"写完，我按照规矩低声念了一遍。","styles":{}}],"id":"bff90162-4528-44d7-86c4-b4f0ae4a1dbb","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她侧着耳朵听着，随后也跟着念了一遍，语调低沉、缓慢，仿佛要将这个名字深深烙进这间阴暗的房屋里。","styles":{}}],"id":"26850713-52a2-4efb-8f4e-6c0f0ec8067f","x-src":"narr"},{"id":"d93bbbeb-57de-43c3-85c6-adb3f75e1cdb","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"念毕，她拿起一旁的红笔，在档案册第一页的编号横线上，用苍劲的手法写下了一串数字。紧接着，她将整本册子翻回封面面对自己，用红笔在牛皮纸的内衬边缘，狠狠划下了一道朱红色的粗线。","styles":{}}],"x-src":"quote-content"},{"type":"dialogue","props":{"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"建档时间是今天，长夜月，冬末。以后不管是你还是巡查员，再有人看这一页——先看时间，再看名字。","styles":{}}],"id":"eab24bb2-eec1-40c2-8022-a62bd3a9ec6c","x-src":"narr"},{"id":"0ae0ad79-03a0-4ebc-8b8c-978e606f0e30","type":"branch","props":{"disabled":false,"branchId":"F2-签法","title":"★口味分支 f2 · 签法","choices":"[{\"mode\":\"jump\",\"text\":\"签\",\"fragmentId\":\"frag-开始-f2-签\",\"jumpTarget\":\"frag-开始-f2-签\"},{\"mode\":\"jump\",\"text\":\"多看一眼再签\",\"fragmentId\":\"frag-开始-f2-多看一眼\",\"jumpTarget\":\"frag-开始-f2-多看一眼\"},{\"mode\":\"jump\",\"text\":\"问一句\\\"什么算陪不过来\\\"\",\"fragmentId\":\"frag-开始-f2-问一句\",\"jumpTarget\":\"frag-开始-f2-问一句\"}]"},"x-note":"f2-branch"},{"type":"scene","props":{"disabled":false,"sceneId":"fad020bf-6eb3-4de3-9884-f5003a3f3a2a","sceneName":"登记处","uri":"","transitionMode":"cover","transitionDuration":"500","transitionDirection":"","transitionStrips":"12","transitionRuleUri":"","transitionCenterX":"50","transitionCenterY":"50","transitionSoftness":"","transitionZoomScale":"1.14","transitionBlurStrength":"16","transitionMosaicSize":"52","transitionGlitchStrength":"100","transitionGlitchColorShift":"4.5","transitionGlitchScanlines":"17","transitionPagePerspective":"50","transitionPageShadow":"38","waitForComplete":"false","resetCamera":"false","displayType":"cover","position":"(center,center)","anchor":"center","size":"","autoAddToGallery":"true","galleryMethodTarget":"avg.internal.default-shell/add-to-gallery"},"id":"0f008f96-8c5d-4434-85c3-cd849fde581f","x-src":"场景 00-5"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她合上半边册子，推回到我面前。","styles":{}}],"id":"e33a0c29-9138-4e7d-8231-aeaf7bb24fa0","x-src":"narr"},{"type":"dialogue","props":{"characterId":"dc4ccb21-1ce4-4ad3-8fa3-5e8a2658bb51","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"册子是你的了。但狗，还没有。","styles":{}}],"id":"ec8d8119-0b07-47fe-8e9e-7de9e22333dd","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她不由分说地从抽屉里甩出一张油墨未干的薄表单和一支笔，拍在档案册旁边。","styles":{}}],"id":"1f798c4b-5cc7-4d36-80ed-51aab510485f","x-src":"bare"},{"type":"dialogue","props":{"characterId":"dc4ccb21-1ce4-4ad3-8fa3-5e8a2658bb51","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":"","disabled":false},"content":[{"type":"text","text":"填。正面写字，背面签字。","styles":{}}],"id":"ffc08f27-424d-4c63-8f96-7dc8bb66c366","x-src":"attr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我默默拾起笔。姓名、住址、哪一栋、几楼、窗户朝向……笔尖在方格中机械地移动。","styles":{}}],"id":"a6f7b1eb-ca76-4a3e-8643-7e2b2201f338","x-src":"narr"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"直到表格中央出现了一栏突兀的问题：【记录员平均每日在家时长：______小时。】","styles":{}}],"id":"4fcc406c-9456-46a5-8463-c76cf13c8b1f","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我的手指骤然僵住了。每天在数据中心与冷链之间往返，我还能有多少时间留在那间逼仄得出租屋里？咬了咬牙，我写下了一个含糊的数字：“6”。","styles":{}}],"id":"b9864eb8-1198-4482-8e7a-986b29ff622d","x-src":"bare"},{"type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"填完最后一格，我依言将表单翻转了过来。","styles":{}}],"id":"354a5032-f827-4640-8247-a7ea9d56dcd0","x-src":"attr"},{"id":"e6f50eb1-f73b-4391-873e-d2c7a455059b","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"——然而。","styles":{}}],"x-src":"quote-content"},{"id":"f78515b4-c359-4e41-8b14-9456db4e026a","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"就在视线触及表单背面的那一瞬间，我的瞳孔骤然放大。","styles":{}}],"x-src":"quote-content"},{"id":"809177db-cff0-46d7-8d0b-1fa9155995e7","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"在空旷无物的反面白纸正中央，印着一行极小、极细的铅印黑字。那行字甚至比正面所有的说明文案都要小上数倍，若不凑在灯泡底下，几乎会让人误以为是一粒印刷灰尘：","styles":{}}],"x-src":"quote-content"},{"id":"8a275a0f-2161-48db-8a2a-2ed5724f8aa0","type":"removeCharacter","props":{"disabled":false,"characterId":"7642a946-bc01-4ffd-8c17-47f9b0678ee2","characterName":"我"},"x-note":"exit-stage"},{"id":"9fa492c9-6942-4c19-8474-aa33918b2e69","type":"removeCharacter","props":{"disabled":false,"characterId":"dc4ccb21-1ce4-4ad3-8fa3-5e8a2658bb51","characterName":"登记处的女人"},"x-note":"exit-stage"},{"id":"c136069e-3ee9-40b6-81ee-6c54f15c534d","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"【——陪不过来的，就别登记。】","styles":{}}],"x-note":"merged"},{"id":"0a34fed0-b95d-41d7-80ef-4deb3f9b4212","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我死死盯着那行字，握着钢笔的手指因为过度用力而泛出惨白。","styles":{}}],"x-note":"merged"},{"id":"44a3a67a-07a6-40c8-8128-b660b2efc4f1","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"空气在这一刻彻底死寂，唯有我的呼吸在寒冷中剧烈起伏。","styles":{}}],"x-note":"merged"},{"id":"d3680c2f-7d83-49cc-8422-97c7d16eb037","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我最终还是落下了笔。她以迅雷不及掩耳之势抽走了表单，将一枚沉重的木柄钢印重重砸在签名之上，动作利落得仿佛刚才那场无声的心理凌迟从未发生过。","styles":{}}],"x-note":"merged"},{"id":"ff4c63bc-d750-475e-8a75-77a23633a5d4","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"今天就到这儿。","styles":{}}],"x-note":"merged"},{"id":"3acd6b03-4c07-489a-85cd-6628b3398e26","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"狗呢？","styles":{}}],"x-note":"merged"},{"id":"7d1b3b90-97e0-45e7-8681-9386641a3b77","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"明天来。八原型在里侧的图鉴架上，通宵亮着长明灯。自己去看。","styles":{}}],"x-note":"merged"},{"id":"369eb864-b47a-4051-83db-36b4b10d9eff","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我捧着那本沉重的空白牛皮档案册，木然地站起身，向门外走去。","styles":{}}],"x-note":"merged"},{"id":"b7dc7c17-b238-4b1d-8b30-2324670cee05","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"就在我的手搭上冰冷的黄铜门把手时，身后传来了她沙哑的声音，这一次，多了一种近乎宿命般的沉重：","styles":{}}],"x-note":"merged"},{"id":"632c75c5-052c-4ffe-826f-b5738b56950f","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"……回去的路上，多抬头看看月亮。","styles":{}}],"x-note":"merged"},{"id":"3a54c25d-c72b-4d41-85d3-2218b88320ab","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我回过头，有些茫然。","styles":{}}],"x-note":"merged"},{"id":"d57357c7-6048-4864-8926-bcacc7436a30","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"我","nameVariantId":"","expression":"","skin":"","position":"left","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"看月亮？","styles":{}}],"x-note":"merged"},{"id":"9d23c464-d7c8-421a-8319-48c82900ca25","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"女人站在柜台后的阴影中，语气平静得令人发指。","styles":{}}],"x-note":"merged"},{"id":"aec52ce5-6da8-465e-8b54-a304d977d560","type":"dialogue","props":{"disabled":false,"characterId":"","characterName":"登记处的女人","nameVariantId":"","expression":"","skin":"","position":"center-right","isFirst":true,"isLast":true,"prevExpression":"","prevNameVariantId":"","showCharacter":true,"keepCharacter":true,"keepDialogue":true,"voiceHash":""},"content":[{"type":"text","text":"你现在每天几点回家，以后就得几点喂它。在这长夜里，有些刻进骨子里的规矩，是一辈子都改不过来的。","styles":{}}],"x-note":"merged"},{"id":"e8c12b67-a7ac-4bc2-8c32-c9479cf8e1f9","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我推开门，门上的铜铃再次发出一声短促的哀鸣。","styles":{}}],"x-note":"merged"},{"id":"316bc2bd-9806-498d-8e24-7531e9de7db2","type":"sound","props":{"disabled":false,"soundId":"se-door","uri":"audio/11bcdc68c94f9fb06d5f7daf1a33f9db.mp3","soundType":"se","volume":"80","loop":"false","fadeDuration":"0"},"x-note":"sfx"},{"id":"6edbecec-a0e0-4ffb-8021-3f5e88873687","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"冰冷刺骨的夜风扑面而来。月亮正斜斜地挂在西方偏下的方位。按照长夜月的历法算法，此刻正是整座城市陷入疲惫沉睡的“傍晚”。","styles":{}}],"x-note":"merged"},{"id":"cc91d848-6ab9-467c-8076-6dc4f7559ed1","type":"removeCharacter","props":{"disabled":false,"characterId":"8eba2050-246d-49b2-8c7f-92afd448f1b3","characterName":"登记处的女人"},"x-note":"timing-exit"},{"id":"f6a5f37c-c97d-4890-8fdb-3d0da37cfbce","type":"removeCharacter","props":{"disabled":false,"characterId":"7491fed9-0faf-478b-8cb0-6fa47e07e9eb","characterName":"我"},"x-note":"timing-exit"},{"id":"fba73d90-c47d-4ba2-8c16-df7789bdc0c1","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"街道上行色匆匆，便利店的白炽灯在冻雾中晕染成一团模糊的光斑。","styles":{}}],"x-note":"merged"},{"id":"3e82ec7e-fce8-4b79-89f9-e30b708c3917","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我下意识地摸了摸大衣内侧的口袋。那本牛皮封面的档案册紧贴着胸口。","styles":{}}],"x-note":"merged"},{"id":"a7737241-0457-4e16-84b2-79ab5d203d12","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"很凉。","styles":{}}],"x-note":"merged"},{"id":"6b34aad5-6222-4e2e-81a1-5e20b4a665db","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"而且……比看上去，要沉重得多。","styles":{}}],"x-note":"merged"},{"id":"9cd12604-0eb0-4983-83a5-72804e1caf9b","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我想了想，家里那张摇摇欲坠的折叠桌上，似乎还剩下一把风干的白挂面。","styles":{}}],"x-note":"merged"},{"id":"d3fee257-e7c5-44e8-816c-b36ae04816cd","type":"removeCharacter","props":{"disabled":false,"characterId":"8eba2050-246d-49b2-8c7f-92afd448f1b3","characterName":"登记处的女人"},"x-note":"stage-exit"},{"id":"72e8f26e-d8ff-41fc-82b2-6d4e5ff07ebc","type":"removeCharacter","props":{"disabled":false,"characterId":"7491fed9-0faf-478b-8cb0-6fa47e07e9eb","characterName":"我"},"x-note":"stage-exit"}]},{"id":"frag-开始-f2-签","name":"f2-签","blocks":[{"id":"b6c2d15a-547f-44a5-87bf-4f8f05fc49e2","type":"setver","props":{"disabled":false,"key":"f2_signed","op":"=","aKind":"lit","aLit":"true","aVar":"","bKind":"none","bLit":"","bVar":"","binOp":"+"},"x-note":"f2-branch"},{"id":"150db326-b373-4844-887f-297381cc756c","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"喉咙深处挤出了低哑的誓言。","styles":{}}],"x-note":"f2-branch"},{"id":"a8657d01-a484-4e4e-8ddf-0a5296681c15","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我把名字重重地签在那行冰冷的小字底下。","styles":{}}],"x-note":"f2-branch"},{"id":"ea51be78-3142-4f26-8c5e-85e8f59f4340","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她在表单上盖下了一个章，很轻地\"嗒\"了一声，仿佛是命运齿轮咬合的轻响。","styles":{}}],"x-note":"merged"}]},{"id":"frag-开始-f2-多看一眼","name":"f2-多看一眼","blocks":[{"id":"76e3991d-69d9-471a-8833-2dade5f4a5b6","type":"setver","props":{"disabled":false,"key":"f2_signed","op":"=","aKind":"lit","aLit":"true","aVar":"","bKind":"none","bLit":"","bVar":"","binOp":"+"},"x-note":"f2-branch"},{"id":"cbbfa431-f452-41ad-8864-69d90f0dbd6b","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"【——陪不过来的，就别登记。】","styles":{}}],"x-note":"f2-branch"},{"id":"b51d5b95-7143-4725-876a-836fa3d81ac6","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"它比正面所有的字都要小，甚至小得让人想要刻意忽略。可是，它就那么冷酷地、直勾勾地趴在那里，宛如一道无声的诅咒。","styles":{}}],"x-note":"f2-branch"},{"id":"c308c3e0-d95c-44bb-8d74-21e6ae880ebf","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我看完了，深吸了一口带着铁锈味的冷气，才落下笔尖。","styles":{}}],"x-note":"f2-branch"},{"id":"d06f12e7-de4a-4dc5-8f8d-c0e13982e278","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她在表单上盖下了一个章，很轻地\"嗒\"了一声，宣告了契约的不可逆转。","styles":{}}],"x-note":"merged"}]},{"id":"frag-开始-f2-问一句","name":"f2-问一句","blocks":[{"id":"c03fe692-2cf1-49c4-864f-c929680ef932","type":"setver","props":{"disabled":false,"key":"f2_signed","op":"=","aKind":"lit","aLit":"true","aVar":"","bKind":"none","bLit":"","bVar":"","binOp":"+"},"x-note":"f2-branch"},{"id":"2ad276d2-d5d5-489b-8ad8-4e748647f2a0","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我抬起头，声音带着一丝微不可查的颤抖。","styles":{}}],"x-note":"f2-branch"},{"id":"d563f467-1d6f-46a2-8eda-43a0431187e1","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"我：“什么算……陪不过来？”","styles":{}}],"x-note":"f2-branch"},{"id":"25c6671c-b649-4604-8b46-c53250014278","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"她没有抬头，手中的笔尖甚至没有停顿半秒。","styles":{}}],"x-note":"f2-branch"},{"id":"fbf9483f-3159-43dd-897f-81acce416576","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"登记处的女人：“你自己心里清楚。”","styles":{}}],"x-note":"f2-branch"},{"id":"21a336d5-5f53-4565-8abe-3e798115ad20","type":"narration","props":{"disabled":false,"keepDialogue":false,"voiceHash":""},"content":[{"type":"text","text":"随后，她才把那枚沉重的钢印盖在我的名字上。没有多余的解释，残酷得理所当然。","styles":{}}],"x-note":"merged"}]}]}