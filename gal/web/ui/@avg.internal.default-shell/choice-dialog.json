      "rect": {
        "x": 587,
        "y": 413,
        "w": 800,
        "h": 74
      },
      "anchor": "c",
      "style": {
        "fontFamily": "\"PingFang SC\", \"Microsoft YaHei\", sans-serif",
        "fontSize": 26,
        "fontWeight": 500,
        "letterSpacing": 0.4,
        "color": "#e8f1f0",
        "opacity": 100,
        "textAlign": "left"
      },
      "props": {
        "choiceListId": "choice-dialog-list",
        "hoverColor": "#f5fffd",
        "pressedColor": "#ffffff",
