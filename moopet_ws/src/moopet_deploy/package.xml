<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moopet_deploy</name>
  <version>0.1.0</version>
  <description>部署档位与大脑宿主：MOOPET_BRAIN=dog|backpack|sim 决定大脑跑在哪一侧，支持断连自治</description>
  <maintainer email="liwenyang@moopet.local">李文扬</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>moopet_core</exec_depend>
  <exec_depend>moopet_link</exec_depend>
  <exec_depend>moopet_hal</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
